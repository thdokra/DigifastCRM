{
  "schema_version": 1,
  "diagram_type": "fluxo",
  "meta": {
    "titulo": "Cadastrar contato e anotar no negócio pelo MCP",
    "pergunta": "Como um agente com papel agent cria uma ficha sem mandar mensagem e deixa um texto na linha do tempo do negócio?",
    "resumo": "crm_create_contact chama createContactHandler com a porta mcp, que não abre conversa. Cargo e empresa vão para custom_fields. Duplicata de telefone, e-mail ou CPF devolve o contato que já existe. crm_add_lead_note grava crm_lead_activities type note, e a timeline lê o reason."
  },
  "lanes": [
    { "id": "chamada", "label": "Quem chama" },
    { "id": "regra", "label": "Regra que já existia" },
    { "id": "dados", "label": "O que fica gravado" },
    { "id": "tela", "label": "Onde a equipe vê" }
  ],
  "mainPath": ["token", "criar", "handler", "ficha", "lista"],
  "nodes": [
    {
